@TTSFreeUse.Api_HostAddress = http://localhost:5138

# Upload a PDF or DOCX and save the returned MP3.
POST {{TTSFreeUse.Api_HostAddress}}/api/speech/convert
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ./sample.pdf
--boundary--
