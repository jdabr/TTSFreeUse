<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8bdafd83-ffde-476c-8e86-858ba49022ec</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TTSFreeUse.Core\TTSFreeUse.Core.csproj" />
  </ItemGroup>

  <!-- Optional Azure engine; see Directory.Build.props. -->
  <ItemGroup Condition="'$(IncludeAzure)' == 'true'">
    <ProjectReference Include="..\TTSFreeUse.Azure\TTSFreeUse.Azure.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IncludeAzure)' == 'true'">
    <DefineConstants>$(DefineConstants);AZURE</DefineConstants>
  </PropertyGroup>

</Project>
