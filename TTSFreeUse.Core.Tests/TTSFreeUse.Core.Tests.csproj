<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TTSFreeUse.Core\TTSFreeUse.Core.csproj" />
  </ItemGroup>

  <!-- The web app's files under test are compiled in directly rather than
       referencing TTSFreeUse.Api, so tests still build while a developer copy
       of the app is running (it locks the Api build output). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="..\TTSFreeUse.Api\LocalOnlyProtection.cs" Link="Linked\LocalOnlyProtection.cs" />
    <Compile Include="..\TTSFreeUse.Api\EngineWarmupService.cs" Link="Linked\EngineWarmupService.cs" />
    <Compile Include="..\TTSFreeUse.Api\Controllers\SpeechController.cs" Link="Linked\SpeechController.cs" />
    <Compile Include="..\TTSFreeUse.Api\Controllers\LibraryController.cs" Link="Linked\LibraryController.cs" />
  </ItemGroup>

</Project>
